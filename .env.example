# Copy this file to .env.local and fill in your keys. .env.local is git-ignored.

# Map stack: google (default) or osm for "Adventure Planner Open"
# (MapLibre + OpenFreeMap map, OSRM/Valhalla routing, Photon search, Overpass places; no Maps key needed)
MAP_PROVIDER=google

# Login options: email, google, facebook, apple (comma-separated). Each must be enabled in
# Firebase → Authentication → Sign-in method; add your site under Authorized domains (localhost too).
AUTH_PROVIDERS=email,google

# Google Maps API key (Maps JavaScript, Directions and Geocoding APIs enabled)
# https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# AI planner: set at least one. Order tried: Claude, then Gemini, then OpenAI.
# Claude (Anthropic API) key: https://platform.claude.com/settings/keys
# A Claude.ai chat subscription does not include API access; API usage is billed separately.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Used when the main model is overloaded (503) or rate-limited (429).
# gemini-flash-latest gives richer plans but is slower and often busy on the free tier.
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Force a provider to go first: claude | gemini | openai
# AI_PROVIDER=

# ---- Plans (src/lib/plans.ts) ----
# Give accounts a plan for testing, without payments: email=plan, comma-separated.
# Plans: free | explorer | trip_pass | pro. (Or set the "plan" field on users/{uid} in Firestore.)
# PLAN_OVERRIDES=you@example.com=explorer
# Change limits without editing code (per day; savedTrips is a total, null = unlimited):
# PLAN_LIMITS={"free":{"aiPlans":10,"placeSearches":20}}
# Checkout links for the Upgrade buttons (e.g. Stripe Payment Links); empty = "Coming soon".
# CHECKOUT_URL_EXPLORER=https://buy.stripe.com/...
# CHECKOUT_URL_TRIP_PASS=https://buy.stripe.com/...
# CHECKOUT_URL_PRO=https://buy.stripe.com/...

# ---- Affiliate links in place popups ("Check prices", "Tickets & tours") ----
# Booking.com Affiliate Partner Program id (aid) and GetYourGuide partner id; empty = links without commission.
# BOOKING_AID=
# GETYOURGUIDE_PARTNER_ID=
