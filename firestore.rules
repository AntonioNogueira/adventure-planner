rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, photoURL, createdAt, plan (free|explorer|trip_pass|pro), planUntil
    //
    // Collection: trips
    // Fields: userId, name, origin, destination, waypoints, travelMode, distance, duration, createdAt,
    //         shared (anyone with the link may read), startDate, avoid, lodging, legs, ...
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() < 128 &&
             data.email is string && data.email.size() < 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1024)) &&
             (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidTrip(data) {
      return data.keys().hasAll(['userId', 'origin', 'destination', 'createdAt']) &&
             data.userId is string && data.userId.size() < 128 &&
             data.origin is string && data.origin.size() < 512 &&
             data.destination is string && data.destination.size() < 512 &&
             data.createdAt is number &&
             (!('name' in data) || (data.name is string && data.name.size() < 256)) &&
             (!('waypoints' in data) || (data.waypoints is list && data.waypoints.size() < 100)) &&
             (!('travelMode' in data) || (data.travelMode is string && data.travelMode.size() < 32)) &&
             (!('distance' in data) || (data.distance is string && data.distance.size() < 64)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() < 64)) &&
             (!('addedOriginInterests' in data) || (data.addedOriginInterests is list && data.addedOriginInterests.size() < 20)) &&
             (!('addedDestinationInterests' in data) || (data.addedDestinationInterests is list && data.addedDestinationInterests.size() < 20)) &&
             (!('shared' in data) || data.shared is bool);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Subscription fields (plan, planUntil) are set by the payment system or by hand in the console,
    // never by the user: creating them is refused and changing them is refused.
    function keepsPlan() {
      return request.resource.data.get('plan', null) == resource.data.get('plan', null)
          && request.resource.data.get('planUntil', null) == resource.data.get('planUntil', null);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data)
                    && !('plan' in request.resource.data) && !('planUntil' in request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && keepsPlan();
    }

    match /trips/{tripId} {
      // Owners can read and list their trips; anyone with the link can open a shared one.
      allow get: if resource == null || resource.data.get('shared', false) == true
                 || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidTrip(request.resource.data);
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid && isValidTrip(request.resource.data);
      allow delete: if isDocOwner();
    }
  }
}
