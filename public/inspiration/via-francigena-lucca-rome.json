ikipedia/commons/thumb/0/0a/Siena5.jpg/500px-Siena5.jpg","page":"Piazza del Campo","source":"https://commons.wikimedia.org/wiki/File:Siena5.jpg","credit":"Ricardo André Frantz (User:Tetraktys)","license":"CC BY-SA 3.0"}},{"name":"San Quirico d'Orcia","place":"San Quirico d'Orcia, Italy","at":[43.0604,11.6036],"text":"The cypress hills of the Val d'Orcia.","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b3/I_cipressi_della_Val_D%27Orcia.jpg/500px-I_cipressi_della_Val_D%27Orcia.jpg","page":"Val d'Orcia","source":"https://commons.wikimedia.org/wiki/File:I_cipressi_della_Val_D%27Orcia.jpg","credit":"Carlo cattaneo fotografie","license":"CC BY-SA 4.0"}},{"name":"Radicofani","place":"Radicofani, Italy","at":[42.8965,11.7697],"text":"A fortress on a hill, the last of Tuscany.","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2f/View_on_Radicofani.jpg/500px-View_on_Radicofani.jpg","page":"Radicofani","source":"https://commons.wikimedia.org/wiki/File:View_on_Radicofani.jpg","credit":"Fischeumel","license":"Public domain"}},{"name":"Bolsena","place":"Bolsena, Italy","at":[42.6441,11.985],"text":"A volcanic crater lake in Lazio.","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Lake_Bolsena_from_Montefiascone.jpg/500px-Lake_Bolsena_from_Montefiascone.jpg","page":"Lake Bolsena","source":"https://commons.wikimedia.org/wiki/File:Lake_Bolsena_from_Montefiascone.jpg","credit":"No machine-readable author provided. Jackyd101 assumed (based on copyright claims).","license":"Public domain"}},{"name":"Viterbo","place":"Viterbo, Italy","at":[42.493,11.9488],"text":"The city of popes; Etruscan sunken roads ahead.","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9a/Palazzo_dei_Papi_Viterbo.jpg/500px-Palazzo_dei_Papi_Viterbo.jpg","page":"Viterbo","source":"https://commons.wikimedia.org/wiki/File:Palazzo_dei_Papi_Viterbo.jpg","credit":"Claudio Caravano","license":"CC BY-SA 4.0"}},{"name":"Sutri","pla