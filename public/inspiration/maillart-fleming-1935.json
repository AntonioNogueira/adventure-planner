20230923100109%29.jpg","page":"Kashgar","source":"https://commons.wikimedia.org/wiki/File:H%C3%ABytgah_Mosque%2C_Kashi_%2820230923100109%29.jpg","credit":"N509FZ","license":"CC BY-SA 4.0"}},{"name":"Gilgit","place":"Gilgit, Pakistan","at":[35.9208,74.314],"text":"Over the passes through Hunza.","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1c/Gilgit_City_a_View_from_Gilgit_serena_hotel.jpg/500px-Gilgit_City_a_View_from_Gilgit_serena_hotel.jpg","page":"Gilgit","source":"https://commons.wikimedia.org/wiki/File:Gilgit_City_a_View_from_Gilgit_serena_hotel.jpg","credit":"Fehd.raza @fehd.raza","license":"CC BY-SA 4.0"}},{"name":"Srinagar","place":"Srinagar, India","at":[34.0747,74.8204],"date":"Sept 1935","text":"Kashmir after seven months.","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/ad/Red_and_Yellow_Tulips.JPG/500px-Red_and_Yellow_Tulips.JPG","page":"Srinagar","source":"https://commons.wikimedia.org/wiki/File:Red_and_Yellow_Tulips.JPG","credit":"Abdars","license":"CC BY-SA 3.0"}}],"legs":[{"by":"train","km":1186,"line":[[39.9057,116.3913],[39.1328,113.0842],[38.2686,109.8531],[37.3179,106.7017],[36.2859,103.6323]]},{"by":"ride","km":251,"line":[[36.2844,103.6351],[36.2663,103.6296],[36.2714,103.5915],[36.197,103.5877],[36.1859,103.5655],[36.1768,103.4315],[36.1413,103.3563],[36.1683,103.3087],[36.173,103.2155],[36.235,103.042],[36.3012,102.9549],[36.3586,102.6931],[36.4042,102.6729],[36.4417,102.5595],[36.4845,102.3142],[36.4782,102.2299],[36.5136,102.1029],[36.5105,101.9991],[36.6522,101.734],[36.6672,101.6443],[36.659,101.5241],[36.7641,101.4856],[36.7743,101.4616],[36.82,101.4333]]},{"by":"unknown","km":703,"line":[[36.8245,101.4408],[36.8522,98.0539],[36.7398,93.5424]]},{"by":"ride","km":697,"line":[[36.7398,93.5424],[37.5207,89.1571],[37.9982,85.8129]]},{"by":"ride","km":529,"line":[[37.9982,85.8129],[37.111,79.9209]]},{"by":"ride","km":498,"line":[[37.111,79.9197],[37.0951,79.9235],[37.0653,79.8911],[37.075,79.8