.com/photos/187460697@N04/49662703498/in/dateposted-public/","license":"CC BY 2.0"}}],"legs":[{"by":"ride","km":129,"line":[[6.2697,-75.602],[6.2543,-75.578],[6.2,-75.5803],[6.1507,-75.636],[6.0568,-75.6418],[6.0454,-75.6844],[6.0134,-75.7067],[6.0411,-75.7576],[6.0088,-75.7669],[6.0056,-75.7998],[5.9633,-75.8494],[5.8668,-75.9157],[5.8329,-75.9025],[5.7655,-75.9077],[5.6402,-75.8746],[5.6355,-75.8605],[5.6126,-75.8706],[5.5994,-75.8191]]},{"by":"ride","km":211,"line":[[5.5994,-75.8191],[5.6096,-75.869],[5.6355,-75.8605],[5.6402,-75.8746],[5.7696,-75.9086],[5.8329,-75.9025],[5.8668,-75.9157],[5.9342,-75.8614],[5.8735,-75.7656],[5.8286,-75.7307],[5.8111,-75.6772],[5.7597,-75.6442],[5.742,-75.6033],[5.6797,-75.6008],[5.6659,-75.5731],[5.6465,-75.5924],[5.5234,-75.5698],[5.3881,-75.6009],[5.3378,-75.6358],[5.3067,-75.639],[5.2895,-75.6632],[5.2018,-75.6393],[5.1434,-75.6732],[5.075,-75.6462],[5.0416,-75.5806],[5.0632,-75.5463],[5.0533,-75.5506],[5.0471,-75.5302],[5.0666,-75.5245],[5.0668,-75.5067]]},{"by":"ride","km":88,"line":[[5.0668,-75.5067],[5.0472,-75.5305],[5.0535,-75.5506],[5.0633,-75.5462],[5.0559,-75.5703],[4.9987,-75.5963],[4.9937,-75.6137],[4.8625,-75.6338],[4.8284,-75.6805],[4.7834,-75.6992],[4.7086,-75.6043],[4.6565,-75.6015],[4.6371,-75.5699]]},{"by":"ride","km":340,"line":[[4.6371,-75.5699],[4.6023,-75.6237],[4.4741,-75.7106],[4.4427,-75.8431],[4.4156,-75.8637],[4.4063,-75.9097],[4.3711,-75.9509],[4.3453,-76.0534],[4.1903,-76.1672],[4.0682,-76.1792],[3.9012,-76.3126],[3.8522,-76.2975],[3.7654,-76.3271],[3.6349,-76.2937],[3.5481,-76.3386],[3.4887,-76.3275],[3.428,-76.35],[3.3104,-76.3609],[3.2923,-76.3472],[3.2352,-76.3866],[3.2312,-76.4223],[3.1744,-76.4576],[3.0374,-76.4795],[3.0265,-76.5001],[2.992,-76.4964],[2.9762,-76.5235],[2.9339,-76.5269],[2.914,-76.549],[2.8231,-76.5371],[2.7992,-76.5535],[2.7551,-76.5543],[2.6855,-76.5272],[2.6428,-76.5371],[2.615,-76.5145],[2.5751,-76.5546],[2.5512,-76.5343],[2.5449,-76.5604],[2.5138,-76.544],[2.4753,-76.5799]