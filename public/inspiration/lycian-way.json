ympos)","place":"Çıralı, Kemer","at":[36.4056,30.4762],"text":"Ruins of Olympos among the trees, and the eternal flames of the Chimaera on the hill.","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/42/Aerial_View_of_Olympus_%28Lycia%29_from_the_west.jpg/500px-Aerial_View_of_Olympus_%28Lycia%29_from_the_west.jpg","page":"Olympus (Lycia)","source":"https://commons.wikimedia.org/wiki/File:Aerial_View_of_Olympus_%28Lycia%29_from_the_west.jpg","credit":"Wikimedia Commons","license":"free licence"}}],"legs":[{"by":"walk","km":18,"line":[[36.5709,29.1403],[36.5417,29.1341],[36.5303,29.1419],[36.52,29.1626],[36.514,29.1534],[36.5057,29.1556],[36.505,29.1468],[36.4965,29.1414],[36.4947,29.1254],[36.482,29.1187]]},{"by":"walk","km":3,"line":[[36.482,29.1187],[36.4694,29.1162],[36.4619,29.126]]},{"by":"walk","km":6,"line":[[36.4619,29.126],[36.4687,29.1464],[36.448,29.143]]},{"by":"walk","km":38,"line":[[36.448,29.143],[36.4417,29.1482],[36.4361,29.1419],[36.4333,29.1467],[36.4221,29.1444],[36.4257,29.1687],[36.4118,29.1927],[36.4012,29.1744],[36.3858,29.1767],[36.3827,29.1711],[36.3576,29.1866],[36.3462,29.1877],[36.3302,29.2076],[36.3309,29.2267],[36.2923,29.2624],[36.258,29.3059],[36.2627,29.3112],[36.2611,29.318]]},{"by":"walk","km":15,"line":[[36.2611,29.318],[36.2803,29.3321],[36.2786,29.349],[36.2683,29.3545],[36.2712,29.362],[36.2655,29.3662],[36.2725,29.3961],[36.2795,29.4064],[36.2654,29.4154]]},{"by":"walk","km":43,"line":[[36.2654,29.4154],[36.2661,29.4205],[36.2541,29.4267],[36.2522,29.4324],[36.2578,29.4374],[36.2701,29.4367],[36.2756,29.4621],[36.266,29.4658],[36.2622,29.4601],[36.2549,29.4791],[36.2439,29.4727],[36.238,29.4902],[36.2378,29.5168],[36.2431,29.5278],[36.2398,29.5474],[36.2363,29.5452],[36.2431,29.5542],[36.2368,29.5871],[36.238,29.6156],[36.233,29.6178],[36.2353,29.6429],[36.2292,29.6407],[36.2325,29.6531],[36.2224,29.6576],[36.2058,29.6456],[36.2055,29.6407],[36.1994,29.6413]]},{"by":"walk","km":29,"line":[[36.1994,29.6413]