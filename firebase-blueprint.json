{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "The user's email address" },
        "displayName": { "type": "string", "description": "The user's display name" },
        "photoURL": { "type": "string", "description": "The user's profile photo URL" },
        "createdAt": { "type": "number", "description": "When the user account was created" }
      },
      "required": ["uid", "email"]
    },
    "Trip": {
      "title": "Trip",
      "description": "A planned travel route",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who owns this trip" },
        "name": { "type": "string", "description": "The name of the trip" },
        "origin": { "type": "string", "description": "Starting location" },
        "originInterests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "destination": { "type": "string", "description": "Ending location" },
        "destinationInterests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "waypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": { "type": "string" },
              "stopover": { "type": "boolean" },
              "interests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "travelMode": { "type": "string" },
        "distance": { "type": "string" },
        "duration": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "origin", "destination", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Trip data"
    }
  }
}
